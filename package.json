{
  "name": "discord-bot-lightweight",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#api/*": "./src/discord/api/*",
    "#commands/*": "./src/discord/commands/*",
    "#events/*": "./src/discord/events/*",
    "#giftbots/*": "./src/discord/giftbots/*",
    "#handlers/*": "./src/discord/handlers/*",
    "#helpers/*": "./src/discord/helpers/*",
    "#managers/*": "./src/discord/managers/*",
    "#scripts/*": "./src/discord/scripts/*",
    "#services/*": "./src/discord/services/*",
    "#structures/*": "./src/discord/structures/*",
    "#models/*": "./src/models/*"
  },
  "description": "Bot de Discord ultra-optimizado y ligero",
  "main": "src/discord/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "node --expose-gc src/discord/index.ts",
    "start:prod": "node --expose-gc src/discord/index.ts",
    "dev": "node --watch src/discord/index.ts",
    "dev:gc": "node --expose-gc --watch src/discord/index.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@google/genai": "^2.4.0",
    "axios": "^1.7.0",
    "canvas": "^3.2.1",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "mongoose": "^8.21.0",
    "pino": "^8.17.2",
    "puppeteer-core": "^24.0.0",
    "sharp": "^0.34.5",
    "stanza": "^12.22.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.2",
    "@vitalets/google-translate-api": "^9.2.1",
    "pino-pretty": "^10.3.1",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "lightweight",
    "optimized"
  ]
}
