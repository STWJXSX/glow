# Standalone Glow repo (rules moved from the monorepo root .gitignore, relative to this folder).

# Dependencies / build output
node_modules/
dist/
.cache/
output/
*.tsbuildinfo

# Local env (the template is versioned)
.env
.env.*
!.env.example

# Local dev scratch / analysis dumps
.sprite-pak-test/
listAssets.json
listAssets.jsonl
docs/
# Glow tooling scripts are local-only (only the scripts package.json ships)
scripts/*
!scripts/package.json
scripts/shop/assets/shop-data/
scripts/shop/cache/
scripts/shop/output/
scripts/cosmetics-extract/output/

# Runtime shop downloads (Fortnite API -> shop_data_*.json, image cache)
src/discord/helpers/data/shop/shop_data_*.json
src/discord/helpers/data/shop/shop_catalog_*.json
src/discord/helpers/data/shop/cache/

# Competitive Epic pool (device auth tokens; bootstrap from deviceAuth.json)
data/competitiveEpicAccounts.json

# Runtime feed / AI usage caches
src/discord/helpers/data/lastFreeGames.json
src/discord/helpers/data/ai-cursor-usage.json

# FN-API cosmetics sync (PNG + catalog JSON) - regenerated by cosmeticsSync cron
src/discord/managers/images/br/locker/assets/cosmetics/**
!src/discord/managers/images/br/locker/assets/cosmetics/.gitkeep

# COMMITTED (do NOT add): assets/sprites/, assets/icons/stw/, managers/images/stw/stw-catalog/,
# helpers/data/maps/, helpers/data/expeditions/, helpers/data/emojis/, helpers/data/images/

# Experimental slash command (local only; not registered in production)
src/discord/commands/epic/core/equipsame.ts

# KickBot pool for /kick + autokick (device auth secrets; template: data/kickBots.example.json)
data/kickBots.json

# Runtime dump written by shopCatalog.ts (regenerated on every shop sync)
src/discord/helpers/epic/br/data/

# Local CA bundle copied from the old system/certs (never commit)
certs/

# Paks cache (the compose `cache` volume)
**/cache/fortnite-paks/

# Secrets scraped from devices/browsers (never commit)
premium.txt
**/deviceAuth*.json
**/cookies*.json
**/*token*.txt

# Logs / OS / editor
logs/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local-only docs (only the README ships)
*.md
!README.md

# Large captures (GitHub 100 MB limit)
**/*.pcapng
**/*.etl

# Workspace leftovers / IDE / agent metadata (same rules as the monorepo root)
dist_win/
dist_linux/
.tsc-out/
.sync-stamp.json
*.swp
*.swo
.vscode/
!.vscode/extensions.json
.cursor/
.agents/
.clinerules/
.windsurf/
.opencode/
copiarse/